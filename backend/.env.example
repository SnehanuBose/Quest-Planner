# Example Environment Variables for Whiteboard Backend
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL

# Server
PORT=8080

# Database Configuration (Neon PostgreSQL / Render Postgres / Local Postgres)
# Replace with your actual credentials in Render Dashboard or local environment
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host-or-localhost>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# JWT Security Settings
# Generate a secure 256-bit key for production (e.g. openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000            # Short-lived access token: 15 minutes (900000 ms)
JWT_REFRESH_EXPIRATION_MS=604800000 # Long-lived refresh token: 7 days (604800000 ms)
