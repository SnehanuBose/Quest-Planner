# Example Environment Variables for Whiteboard Backend
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL

# Server
PORT=8080

# Database Configuration (Neon PostgreSQL / Render Postgres / Local Postgres)
# Replace with your actual credentials in Render Dashboard or local environment
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host-or-localhost>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS_PATTERNS=https://*.vercel.app
